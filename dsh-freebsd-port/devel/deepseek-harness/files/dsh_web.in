#!/bin/sh
# PROVIDE: dsh_web
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# dsh_web — DeepSeek Harness (deepseek-harness) web UI service.
#
# Enable in /etc/rc.conf or /etc/rc.conf.local:
#
#   dsh_web_enable="YES"
#
# Optional settings (defaults in parentheses):
#   dsh_web_user       (www)          user the service runs as
#   dsh_web_host       (127.0.0.1)    bind host — read the loopback
#                                     trust-fence note in pkg-message
#                                     before changing this
#   dsh_web_port       (3080)         listen port
#   dsh_web_chdir      (/var/db/dsh)  service state home (DSH_HOME) AND the
#                                     default cwd for every agent command
#   dsh_web_env        (HOME, DSH_HOME, PATH)  extra environment
#   dsh_web_env_file   (unset)        file to source extra environment from
#   dsh_web_token_wait (120)          seconds to wait for the auth token
#   dsh_web_log        (/var/log/dsh_web.log)
#
# The web UI prints a one-time auth token on start; `service dsh_web start`
# echoes the full URL. All harness state (config, sessions, tokens) lives
# under DSH_HOME.

. %%RC_SUBR%%

name="dsh_web"
rcvar="dsh_web_enable"

load_rc_config $name

: ${dsh_web_enable:="NO"}
: ${dsh_web_user:="www"}
: ${dsh_web_host:="127.0.0.1"}
: ${dsh_web_port:="3080"}
: ${dsh_web_chdir:="/var/db/dsh"}
: ${dsh_web_token_wait:="120"}
: ${dsh_web_log:="/var/log/dsh_web.log"}

# The pidfile lives inside the service-owned state dir: /var/run is not
# writable by the service user, and daemon -P writes the pidfile as that user.
pidfile="${dsh_web_chdir}/dsh_web.pid"
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -o ${dsh_web_log} %%PREFIX%%/bin/dsh web --host ${dsh_web_host} --port ${dsh_web_port} --no-open"

# rc.subr switches to dsh_web_user with `su -m`, which preserves the caller's
# environment: HOME must be pinned or the service inherits root's HOME and
# cannot create its state directory. DSH_HOME pins the harness state root
# (config/sessions/tokens) to the service-owned directory. `_chdir` makes the
# daemon start inside dsh_web_chdir, which becomes the default working
# directory for every bash/grep/terminal command the agent runs.
: ${dsh_web_env:="HOME=${dsh_web_chdir} DSH_HOME=${dsh_web_chdir} PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"}

# --- state dir --------------------------------------------------------------
# Create the state dir (the daemon runs as dsh_web_user and cannot write to
# /var/run or create files in /var/log), and make sure the log exists and is
# owned by the service user before daemon -o opens it.
dsh_web_precmd() {
    /usr/bin/install -d -o "${dsh_web_user}" -m 0750 "${dsh_web_chdir}"
    if [ ! -f "${dsh_web_log}" ]; then
        /usr/bin/install -o "${dsh_web_user}" -m 0640 /dev/null "${dsh_web_log}"
    else
        chown "${dsh_web_user}" "${dsh_web_log}" 2>/dev/null || true
    fi
    dsh_web_log_before=$(wc -l < "${dsh_web_log}" 2>/dev/null || echo 0)
}

# --- stop -------------------------------------------------------------------
# daemon -P only supervises the wrapper pid; the wrapper exec's node, so the
# pids coincide — but kill the whole pattern as a belt-and-braces measure and
# wait for the port to be released: a lingering listener makes the next start
# fail with EADDRINUSE.
dsh_web_stop() {
    if [ -f "${pidfile}" ]; then
        kill -TERM "$(cat "${pidfile}")" 2>/dev/null
    fi
    pkill -f "[l]ibexec/deepseek-harness" 2>/dev/null
    local i
    for i in $(seq 1 20); do
        if sockstat -l -p "${dsh_web_port}" 2>/dev/null | grep -q ":${dsh_web_port}"; then
            sleep 1
        else
            break
        fi
    done
    rm -f "${pidfile}"
}

# --- status -----------------------------------------------------------------
dsh_web_status() {
    if sockstat -l -p "${dsh_web_port}" 2>/dev/null | grep -q ":${dsh_web_port}"; then
        echo "dsh_web is RUNNING on ${dsh_web_host}:${dsh_web_port}"
        pgrep -f "[l]ibexec/deepseek-harness" | while read p; do echo "  pid $p"; done
    else
        echo "dsh_web is NOT running"
        return 1
    fi
}

# --- token ------------------------------------------------------------------
# Wait for the freshly generated auth token to appear in the log (from the
# line count captured in dsh_web_precmd onward), then echo the full URL.
dsh_web_wait_token() {
    local i token start_line
    start_line=$((dsh_web_log_before + 1))
    for i in $(seq 1 "${dsh_web_token_wait}"); do
        token=$(tail -n +"$start_line" "${dsh_web_log}" 2>/dev/null | grep -oE "token=[A-Za-z0-9_-]+" | tail -1 | cut -d= -f2-)
        if [ -n "$token" ]; then
            break
        fi
        sleep 1
    done
    if [ -n "$token" ]; then
        echo ""
        echo "dsh web is up."
        echo "Open:  http://${dsh_web_host}:${dsh_web_port}/?token=${token}"
        echo "Log:   tail -f ${dsh_web_log}"
    else
        echo "dsh web launched but the token line has not appeared yet; check ${dsh_web_log}"
    fi
}

start_precmd="dsh_web_precmd"
start_postcmd="dsh_web_wait_token"
stop_cmd="dsh_web_stop"
status_cmd="dsh_web_status"

run_rc_command "$1"
